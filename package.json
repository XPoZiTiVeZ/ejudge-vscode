{
  "name": "ejudge-vscode",
  "displayName": "Ejudge",
  "description": "Ejudge sidebar",
  "version": "1.0.16",
  "publisher": "XpozitiveZ",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XpozitiveZ/ejudge-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ejudgeContainer",
          "title": "Ejudge",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ejudgeContainer": [
        {
          "id": "ejudgeContests",
          "name": "Contests"
        }
      ]
    },
    "commands": [
      {
        "command": "ejudge.addContest",
        "title": "Ejudge: Add contest",
        "icon": "$(add)"
      },
      {
        "command": "ejudge.editContest",
        "title": "Ejudge: Edit contest",
        "icon": "$(edit)"
      },
      {
        "command": "ejudge.editSelectors",
        "title": "Ejudge: Edit selectors (advanced, for version quirks)",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ejudge.deleteContest",
        "title": "Ejudge: Delete contest",
        "icon": "$(trash)"
      },
      {
        "command": "ejudge.openContest",
        "title": "Ejudge: Open contest page"
      },
      {
        "command": "ejudge.reloadContest",
        "title": "Ejudge: Reload contest tab",
        "icon": "$(refresh)"
      },
      {
        "command": "ejudge.back",
        "title": "Ejudge: Go back",
        "icon": "$(arrow-left)"
      },
      {
        "command": "ejudge.forward",
        "title": "Ejudge: Go forward",
        "icon": "$(arrow-right)"
      },
      {
        "command": "ejudge.showLogs",
        "title": "Ejudge: Show logs",
        "icon": "$(output)"
      },
      {
        "command": "ejudge.itemClicked",
        "title": "Ejudge: internal click handler"
      },
      {
        "command": "ejudge.sendCurrentFileToContest",
        "title": "Ejudge: отправить текущий файл в контест",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ejudge.syncNow",
        "title": "Ejudge: синхронизировать контесты (GitHub Gist)",
        "icon": "$(sync)"
      },
      {
        "command": "ejudge.setPassword",
        "title": "Ejudge: изменить пароль контеста",
        "icon": "$(key)"
      },
      {
        "command": "ejudge.setProxyPassword",
        "title": "Ejudge: изменить пароль прокси"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ejudge.addContest",
          "when": "view == ejudgeContests",
          "group": "navigation"
        },
        {
          "command": "ejudge.showLogs",
          "when": "view == ejudgeContests",
          "group": "navigation"
        },
        {
          "command": "ejudge.syncNow",
          "when": "view == ejudgeContests",
          "group": "navigation"
        },
        {
          "command": "ejudge.setPassword",
          "when": "view == ejudgeContests",
          "group": "1_secrets"
        },
        {
          "command": "ejudge.setProxyPassword",
          "when": "view == ejudgeContests",
          "group": "1_secrets"
        }
      ],
      "view/item/context": [
        {
          "command": "ejudge.editContest",
          "when": "view == ejudgeContests",
          "group": "inline"
        },
        {
          "command": "ejudge.editSelectors",
          "when": "view == ejudgeContests",
          "group": "1_selectors"
        },
        {
          "command": "ejudge.deleteContest",
          "when": "view == ejudgeContests",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "ejudge.back",
          "when": "activeWebviewPanelId == 'ejudgeContest'",
          "group": "navigation@1"
        },
        {
          "command": "ejudge.forward",
          "when": "activeWebviewPanelId == 'ejudgeContest'",
          "group": "navigation@2"
        },
        {
          "command": "ejudge.reloadContest",
          "when": "activeWebviewPanelId == 'ejudgeContest'",
          "group": "navigation@3"
        },
        {
          "command": "ejudge.sendCurrentFileToContest",
          "group": "navigation@100",
          "when": "resourceScheme == file || resourceScheme == untitled"
        }
      ],
      "commandPalette": [
        {
          "command": "ejudge.editContest",
          "when": "false"
        },
        {
          "command": "ejudge.editSelectors",
          "when": "false"
        },
        {
          "command": "ejudge.deleteContest",
          "when": "false"
        },
        {
          "command": "ejudge.openContest",
          "when": "false"
        },
        {
          "command": "ejudge.itemClicked",
          "when": "false"
        },
        {
          "command": "ejudge.setPassword",
          "when": "false"
        },
        {
          "command": "ejudge.setProxyPassword",
          "when": "false"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "get_ejudge_problem",
        "displayName": "Условие задачи ejudge",
        "modelDescription": "Возвращает условие (исходная разметка, формулы в LaTeX), ограничения, языки и краткую таблицу последних посылок задачи ejudge, открытой в панели контеста. Можно указать название другой задачи контеста.",
        "toolReferenceName": "ejudgeProblem",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "problem": {
              "type": "string",
              "description": "Название задачи (например mz01-1). Пусто — открытая задача."
            }
          }
        }
      },
      {
        "name": "get_ejudge_last_submit",
        "displayName": "Последняя посылка ejudge",
        "modelDescription": "Возвращает полную информацию о последней посылке открытой задачи ejudge: вердикт, исходный код и отчёт по тестам.",
        "toolReferenceName": "ejudgeLastSubmit",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "get_ejudge_submission",
        "displayName": "Посылка ejudge по номеру",
        "modelDescription": "Возвращает исходный код или отчёт по тестам посылки открытой задачи ejudge по её номеру.",
        "toolReferenceName": "ejudgeSubmission",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "description": "Номер посылки"
            },
            "kind": {
              "type": "string",
              "enum": [
                "source",
                "report"
              ]
            }
          },
          "required": [
            "runId",
            "kind"
          ]
        }
      },
      {
        "name": "list_ejudge_problems",
        "displayName": "Задачи контеста ejudge",
        "modelDescription": "Возвращает список задач контеста ejudge со статусами, группами и временем сервера.",
        "toolReferenceName": "ejudgeProblems",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "get_ejudge_problem",
        "displayName": "Условие задачи ejudge",
        "modelDescription": "Возвращает условие (исходная разметка, формулы в LaTeX), ограничения, языки и краткую таблицу последних посылок задачи ejudge, открытой в панели контеста. Можно указать название другой задачи контеста.",
        "toolReferenceName": "ejudgeProblem",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "problem": {
              "type": "string",
              "description": "Название задачи (например mz01-1). Пусто — открытая задача."
            }
          }
        }
      },
      {
        "name": "submit_ejudge_problem",
        "displayName": "Отправить решение в ejudge",
        "modelDescription": "Отправляет решение в задачу ejudge, открытую в панели контеста. Передай либо file (путь к файлу решения), либо code вместе с fileName (имя с расширением языка, например solution.c). Тратит попытку, пользователь подтверждает вызов. Результат отправки приходит текстом.",
        "toolReferenceName": "submitProblem",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Путь к файлу решения (абсолютный или от корня рабочей папки)."
            },
            "code": {
              "type": "string",
              "description": "Исходный код решения, если файла нет."
            },
            "fileName": {
              "type": "string",
              "description": "Имя файла с расширением языка, например solution.c. Обязательно вместе с code."
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "socks-proxy-agent": "^8.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
